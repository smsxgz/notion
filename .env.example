# Telegram Bot Token
# Create a bot via @BotFather on Telegram, copy the token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# (Optional) Comma-separated Telegram user IDs allowed to use the bot
# Leave empty to allow everyone. Find your ID via @userinfobot
TELEGRAM_ALLOWED_USERS=

# Anthropic API Key
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Notion Integration Token
# Get it from: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx

# Notion Database IDs
# Create two databases in Notion, then copy their IDs from the URL
# URL format: https://www.notion.so/<workspace>/<database_id>?v=...
#
# Reminders database - required properties:
#   Name (title), Deadline (date), Status (select: Pending/Done), Tags (multi_select)
#
# Notes database - required properties:
#   Name (title), Date (date), Category (select), Tags (multi_select)

NOTION_REMINDERS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_NOTES_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
